# 转发目标：Mac mini 后端的 /msg（经 cloudflared 隧道）。
# 隧道 URL 会变；首次填当前值，之后可由 Mac mini 端自动 set-target 更新。
TARGET_MSG_URL=https://honolulu-impossible-expressed-labs.trycloudflare.com/msg

# /set-target 的共享密钥（Mac mini 远程更新目标时校验）。自己生成一个随机串。
FORWARD_SECRET=

# 目标地址持久化文件（重启不丢）
TARGET_FILE=target.txt

# 转发到后端的超时（秒）
FORWARD_TIMEOUT=10
