database_url=postgresql+asyncpg://postgres:postgres@localhost:5432/superuserai
redis_url=redis://localhost:6379
vwork_api_host=<your-vwork-server-ip>
vwork_api_port=8989
vwork_msg_port=9000
github_token=<your-github-personal-access-token>
github_webhook_secret=<your-webhook-secret>
llm_provider=openai
llm_api_key=<your-llm-api-key>
llm_base_url=https://api.openai.com/v1
llm_model=gpt-4.1-mini
jwt_secret=<run: openssl rand -hex 32>
jwt_algorithm=HS256
jwt_expire_minutes=1440

# Staging auto-deploy
staging_ssh_key_path=
staging_ssh_user_default=deploy
staging_deploy_timeout_sec=600
staging_log_tail_lines=200
